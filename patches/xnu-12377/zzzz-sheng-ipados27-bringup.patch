+/*
+ * Fault one backing page into a kernel buffer (mirrors shared_region_pager_peek).
+ * Used when the fixup page size exceeds PAGE_SIZE so the full fixup page can be assembled.
+ */
+static kern_return_t
+dyld_pager_peek(
+	vm_object_t                    object,
+	vm_object_offset_t             backing_offset,
+	void                           *buffer,
+	struct vm_object_fault_info    *fault_info)
+{
+	vm_page_t page, top_page;
+	vm_prot_t prot;
+	kern_return_t error_code;
+	vm_fault_return_t vmfr;
+	/* The caller's fault_info may have been mutated by the page's own fault (shadow offset); fault the peeked page at its own range. */
+	struct vm_object_fault_info local_fault = *fault_info;
+	local_fault.lo_offset = backing_offset;
+	local_fault.hi_offset = backing_offset + PAGE_SIZE;
+
+retry:
+	vm_page_grab_prime();
+	vm_object_lock(object);
+	vm_object_paging_begin(object);
+	error_code = 0;
+	prot = VM_PROT_READ;
+	page = VM_PAGE_NULL;
+	vmfr = vm_fault_page(object, backing_offset, VM_PROT_READ, FALSE, FALSE, &prot, &page, &top_page, NULL,
+	    &error_code, FALSE, &local_fault, NULL);
+	switch (vmfr) {
+	case VM_FAULT_SUCCESS:
+		break;
+	case VM_FAULT_RETRY:
+		goto retry;
+	case VM_FAULT_MEMORY_SHORTAGE:
+		if (vm_page_wait(local_fault.interruptible)) {
+			goto retry;
+		}
+		return KERN_RESOURCE_SHORTAGE;
+	case VM_FAULT_SUCCESS_NO_VM_PAGE:
+		vm_object_paging_end(object);
+		vm_object_unlock(object);
+		return KERN_MEMORY_ERROR;
+	default:
+		return KERN_MEMORY_ERROR;
+	}
+	vm_object_t page_object = VM_PAGE_OBJECT(page);
+	const void *source = (const void *)phystokv((pmap_paddr_t)VM_PAGE_GET_PHYS_PAGE(page) << PAGE_SHIFT);
+	if (page_object->code_signed) {
+		vm_page_validate_cs_mapped(page, PAGE_SIZE, 0, source);
+	}
+	const bool tainted = page->vmp_cs_tainted;
+	if (!tainted) {
+		bcopy(source, buffer, PAGE_SIZE);
+	}
+	static int sheng_peek_logged = 0;
+	if (sheng_peek_logged < 8) {
+		uint64_t first8 = 0;
+		memcpy(&first8, buffer, sizeof(first8));
+		printf("sheng-peek[%d]: off=0x%llx tainted=%d first8=0x%llx pnum=0x%x page_obj=%p top_obj=%p\n",
+		    sheng_peek_logged, (unsigned long long)backing_offset, tainted, (unsigned long long)first8,
+		    (unsigned int)VM_PAGE_GET_PHYS_PAGE(page), (void *)page_object, (void *)VM_PAGE_OBJECT(top_page));
+		sheng_peek_logged++;
+	}
+	vm_page_wakeup_done(page_object, page);
+	vm_object_paging_end(page_object);
+	vm_object_unlock(page_object);
+	if (top_page != VM_PAGE_NULL) {
+		vm_object_lock(object);
+		VM_PAGE_FREE(top_page);
+		vm_object_paging_end(object);
+		vm_object_unlock(object);
+	}
+	return tainted ? KERN_CODESIGN_ERROR : KERN_SUCCESS;
+}
