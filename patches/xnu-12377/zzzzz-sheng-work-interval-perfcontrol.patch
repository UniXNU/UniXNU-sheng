diff --git a/osfmk/kern/work_interval.c b/osfmk/kern/work_interval.c
index 8e22ab1..7e4f0fd 100644
--- a/osfmk/kern/work_interval.c
+++ b/osfmk/kern/work_interval.c
@@ -1049,6 +1049,24 @@ work_interval_thread_terminate(thread_t thread)
 	return KERN_SUCCESS;
 }
 
+/*
+ * sheng: an interval instance operation from the thread that joined the interval. The performance controller registered with
+ * sched_perfcontrol_register_callbacks (work_interval_ctl) is told; without one the call only succeeds.
+ */
+kern_return_t
+kern_work_interval_instance_ctl(thread_t thread, struct kern_work_interval_instance_args *args)
+{
+	assert(thread == current_thread());
+	struct work_interval *work_interval = thread->th_work_interval;
+
+	if (work_interval == NULL || work_interval->wi_id != args->work_interval_id) {
+		return KERN_INVALID_ARGUMENT;
+	}
+	args->create_flags = work_interval->wi_create_flags;
+	machine_work_interval_ctl(thread, args);
+	return KERN_SUCCESS;
+}
+
 kern_return_t
 kern_work_interval_notify(thread_t thread, struct kern_work_interval_args* kwi_args)
 {
