 }
 
 
+/* An interval instance start (6), update (7) or finish (8): the controller gets the instance, and names it on a start. */
+void
+machine_work_interval_ctl(thread_t thread, struct kern_work_interval_instance_args *args)
+{
+	static uint64_t instance_counter;
+
+	if (args->op == 6 && args->instance_id == 0) {
+		args->instance_id = os_atomic_inc(&instance_counter, relaxed);
+	}
+	if (sched_perfcontrol_work_interval_ctl == sched_perfcontrol_work_interval_ctl_default) {
+		return;
+	}
+	perfcontrol_state_t state = FIND_PERFCONTROL_STATE(thread);
+	struct perfcontrol_work_interval_instance instance = {
+		.ctl              = args->op == 6 ? WORK_INTERVAL_START : (args->op == 7 ? WORK_INTERVAL_UPDATE : WORK_INTERVAL_FINISH),
+		.create_flags     = args->create_flags,
+		.complexity       = args->complexity,
+		.thread_id        = thread->thread_id,
+		.work_interval_id = args->work_interval_id,
+		.instance_id      = args->instance_id,
+		.start            = args->start,
+		.finish           = args->finish,
+		.deadline         = args->deadline,
+	};
+#if CONFIG_THREAD_GROUPS
+	struct thread_group *tg = thread_group_get(thread);
+	instance.thread_group_id = thread_group_get_id(tg);
+	instance.thread_group_data = thread_group_get_machine_data(tg);
+#endif
+	sched_perfcontrol_work_interval_ctl(state, &instance);
+	if (args->op == 6 && instance.instance_id) {
+		args->instance_id = instance.instance_id;
+	}
+}
