diff --git a/bsd/kern/sys_work_interval.c b/bsd/kern/sys_work_interval.c
index 527f029..0d97e92 100644
--- a/bsd/kern/sys_work_interval.c
+++ b/bsd/kern/sys_work_interval.c
@@ -295,6 +295,28 @@ work_interval_ctl(__unused proc_t p, struct work_interval_ctl_args *uap,
 		if (uap->arg == USER_ADDR_NULL || uap->work_interval_id == 0) {
 			return EINVAL;
 		}
+		{
+			/* The OS's instance record, 96 bytes: [0] interval id, [8] instance id, [0x10] start, [0x18] finish, [0x20] deadline,
+			 * [0x28] complexity, [0x30] the interval's create flags, the rest telemetry. A start names the instance (the library
+			 * skips an update or finish on an unnamed one). The performance controller sees them; nothing here may fail the caller. */
+			uint64_t record[6] = {0};
+			if (uap->len < sizeof(record) || copyin(uap->arg, record, sizeof(record)) != 0) {
+				break;
+			}
+			struct kern_work_interval_instance_args instance_args = {
+				.op               = operation,
+				.work_interval_id = uap->work_interval_id,
+				.instance_id      = record[1],
+				.start            = record[2],
+				.finish           = record[3],
+				.deadline         = record[4],
+				.complexity       = record[5],
+			};
+			if (kern_work_interval_instance_ctl(current_thread(), &instance_args) == KERN_SUCCESS &&
+			    operation == 6 && instance_args.instance_id != record[1]) {
+				(void)copyout(&instance_args.instance_id, uap->arg + sizeof(uint64_t), sizeof(uint64_t));
+			}
+		}
 		break;
 
 	default:
