 #if DEVELOPMENT || DEBUG
 	/* Use the opportunity to initialize exec's debug log stream */
+	boot_progress_stage("exec log create enter");
 	exec_log_handle = os_log_create("com.apple.xnu.bsd", "exec");
+	boot_progress_stage("exec log create returned");
 #endif /* DEVELOPMENT || DEBUG */
 
+	boot_progress_stage("init scratch allocate enter");
 	(void) mach_vm_allocate_kernel(map, &scratch_addr, map_page_size,
 	    VM_MAP_KERNEL_FLAGS_ANYWHERE());
+	boot_progress_stage("init scratch allocate returned");
 	user_addr_t init_envp = USER_ADDR_NULL;
 #if defined(XNU_OWNER_CACHE_MOUNT) && XNU_OWNER_CACHE_MOUNT
 	boot_progress_stage("SystemOS mount enter");
